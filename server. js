import express from "express";

const app = express();

app.use(express.json());

app.get("/", (req, res) => {
  res.json({
    status: "ok",
    message: "Backend LiterasiKu aktif."
  });
});

app.post("/api/bantuan", async (req, res) => {
  try {
    const { question, context } = req.body;

    if (!question) {
      return res.status(400).json({
        error: "Pertanyaan belum diisi."
      });
    }

    const response = await fetch(
      "https://api.openai.com/v1/responses",
      {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "Authorization": `Bearer ${process.env.OPENAI_API_KEY}`
        },
        body: JSON.stringify({
          model: "gpt-5-mini",
          instructions:
            "Kamu adalah Asisten Belajar LiterasiKu. " +
            "Bantu siswa memahami Bahasa Indonesia. " +
            "Jangan langsung memberikan jawaban soal. " +
            "Berikan petunjuk dan penjelasan agar siswa tetap berpikir. " +
            "Gunakan bahasa Indonesia yang jelas dan sesuai kaidah.",
          input:
            `Materi: ${context || "Tidak ada materi khusus"}\n\n` +
            `Pertanyaan siswa: ${question}`
        })
      }
    );

    const data = await response.json();

    if (!response.ok) {
      return res.status(500).json({
        error: data.error?.message || "AI mengalami kesalahan."
      });
    }

    res.json({
      answer: data.output_text || "Belum ada respons."
    });

  } catch (error) {
    console.error(error);

    res.status(500).json({
      error: "Server LiterasiKu mengalami kesalahan."
    });
  }
});

const PORT = process.env.PORT || 3000;

app.listen(PORT, "0.0.0.0", () => {
  console.log(`LiterasiKu backend berjalan pada port ${PORT}`);
});
