export default async function handler(req, res) {
  if (req.method !== "POST") {
    return res.status(405).json({
      error: "Gunakan metode POST."
    });
  }

  const question = req.body && req.body.question;

  if (!question) {
    return res.status(400).json({
      error: "Pertanyaan belum diisi."
    });
  }

  try {
    const response = await fetch("https://api.openai.com/v1/responses", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "Authorization": "Bearer " + process.env.OPENAI_API_KEY
      },
      body: JSON.stringify({
        model: "gpt-5-mini",
        input:
          "Kamu adalah Asisten Belajar LiterasiKu. " +
          "Bantu siswa memahami Bahasa Indonesia. " +
          "Jangan langsung memberikan jawaban soal. " +
          "Berikan petunjuk dan penjelasan agar siswa tetap berpikir. " +
          "Pertanyaan siswa: " + question
      })
    });

    const data = await response.json();

    if (!response.ok) {
      return res.status(500).json({
        error: "AI tidak dapat memberikan respons."
      });
    }

    return res.status(200).json({
      answer: data.output_text
    });

  } catch (error) {
    return res.status(500).json({
      error: "Terjadi kesalahan pada server."
    });
  }
}
